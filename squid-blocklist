#!/bin/bash
# ============================================================================
#  squid-blocklist  —  privileged helper for the Squid dashboard
# ============================================================================
#  Installed on the PROXY server. The dashboard never edits squid.conf; it only
#  calls this script, which appends/removes entries in dedicated list files and
#  reloads Squid. Every change is validated, backed up, and audited, and is
#  rolled back automatically if Squid would refuse the new config.
#
#  INSTALL (on the proxy, as root):
#      install -o root -g root -m 0755 squid-blocklist /usr/local/sbin/
#      /usr/local/sbin/squid-blocklist init
#      # then add the printed lines to squid.conf and reload
#      echo 'USER ALL=(root) NOPASSWD: /usr/local/sbin/squid-blocklist' \
#          > /etc/sudoers.d/squid-blocklist
#      chmod 0440 /etc/sudoers.d/squid-blocklist
#
#  USAGE
#      squid-blocklist init
#      squid-blocklist status
#      squid-blocklist list   <domains|ips|urls|allow>
#      squid-blocklist add    <domains|ips|urls|allow> <entry>
#      squid-blocklist del    <domains|ips|urls|allow> <entry>
#      squid-blocklist rollback <domains|ips|urls|allow>
#
#  Exit codes: 0 ok · 2 usage/validation · 3 config rejected (rolled back)
#              4 reload failed (rolled back) · 5 refused (protected/unsafe)
# ============================================================================
set -uo pipefail

# Overridable for testing; defaults are the real locations.
DIR="${SQUID_BL_DIR:-/etc/squid}"
SQUID_BIN="${SQUID_BIN:-squid}"
AUDIT="${SQUID_BL_AUDIT:-/var/log/squid/blocklist_audit.log}"
MIN_PREFIX="${SQUID_BL_MIN_PREFIX:-24}"   # refuse to block anything broader

DOMAINS="$DIR/blocklist_domains.txt"
IPS="$DIR/blocklist_ips.txt"
URLS="$DIR/blocklist_urls.txt"
ALLOW="$DIR/allowlist_domains.txt"
PROTECT="$DIR/blocklist_protected.txt"
BACKUPS="$DIR/blocklist_backups"
LOCK="$DIR/.blocklist.lock"

PLACEHOLDER_DOMAIN="blocked.invalid"
PLACEHOLDER_IP="192.0.2.1"          # RFC5737 documentation address
PLACEHOLDER_URL="^https?://blocked\.invalid/"

# Ordinary URLs a url_regex pattern must NOT match — catches patterns so broad
# they would take the whole bank offline.
CANARY_URLS=(
  "http://www.cb.example.gov/index.html"
  "http://windowsupdate.microsoft.com/v9/update.cab"
  "http://www.google.com/search?q=x"
  "http://intranet.local/app/login"
)

# Domains that must never be blocked even if asked. Extend via
# blocklist_protected.txt on the proxy (one entry per line).
DEFAULT_PROTECTED=(
  "windowsupdate.com" "update.microsoft.com" "microsoftonline.com"
  "office365.com" "officecdn.microsoft.com"
  "cb.example.gov" "centralbank.example.gov" "swift.com"
  "visa.com" "mastercard.com"
  "localhost" "localdomain"
)

die()  { echo "ERROR: $*" >&2; exit "${2:-2}"; }
info() { echo "$*"; }

# ---------------------------------------------------------------- self-check
# If a non-root user can modify this script, the sudoers grant becomes a root
# escalation. Refuse to run in that case.
self_check() {
  local me; me="$(readlink -f "$0")"
  [ -f "$me" ] || return 0
  local owner perms
  owner="$(stat -c %u "$me" 2>/dev/null || echo 0)"
  perms="$(stat -c %a "$me" 2>/dev/null || echo 755)"
  if [ "$owner" != "0" ]; then
    die "$me must be owned by root (found uid $owner)" 5
  fi
  case "$perms" in
    *[2367]) die "$me is group/world-writable ($perms) — chmod 0755" 5 ;;
  esac
}

# NOTE: validate the kind via require_kind BEFORE calling file_for. A `die`
# inside a command substitution only kills the subshell, so file_for cannot be
# relied on to abort the script.
valid_kind() {
  case "${1:-}" in domains|ips|urls|allow) return 0 ;; *) return 1 ;; esac
}

require_kind() {
  valid_kind "${1:-}" || die "unknown list '${1:-}' (use domains|ips|urls|allow)"
}

file_for() {
  case "$1" in
    domains) echo "$DOMAINS" ;;
    ips)     echo "$IPS" ;;
    urls)    echo "$URLS" ;;
    allow)   echo "$ALLOW" ;;
    *) echo "" ;;
  esac
}

placeholder_for() {
  case "$1" in
    ips)  echo "$PLACEHOLDER_IP" ;;
    urls) echo "$PLACEHOLDER_URL" ;;
    *)    echo "$PLACEHOLDER_DOMAIN" ;;
  esac
}

# ---------------------------------------------------------------- validation
valid_domain() {
  local d="$1"
  # optional leading dot (Squid subdomain match), labels, TLD
  [[ "$d" =~ ^\.?([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\.)+[a-zA-Z]{2,}$ ]] || return 1
  [ "${#d}" -le 253 ] || return 1
  [[ "$d" != *".."* ]] || return 1
  return 0
}

valid_ip_or_cidr() {
  local e="$1" ip prefix
  if [[ "$e" == */* ]]; then
    ip="${e%%/*}"; prefix="${e##*/}"
    [[ "$prefix" =~ ^[0-9]{1,2}$ ]] || return 1
    [ "$prefix" -ge 0 ] && [ "$prefix" -le 32 ] || return 1
  else
    ip="$e"; prefix=32
  fi
  local -a o
  IFS=. read -r -a o <<< "$ip"
  [ "${#o[@]}" -eq 4 ] || return 1
  for x in "${o[@]}"; do
    [[ "$x" =~ ^[0-9]{1,3}$ ]] || return 1
    [ "$x" -le 255 ] || return 1
  done
  # refuse dangerously broad blocks (would cut off the whole network)
  if [ "$prefix" -lt "$MIN_PREFIX" ]; then
    die "refusing /$prefix — too broad, would block a whole network (min /$MIN_PREFIX)" 5
  fi
  return 0
}

# Does $2 (an ERE) match the string $1?  0 = match, 1 = no match, 2 = bad regex
re_match() {
  printf '%s\n' "$1" | grep -Eq -- "$2" 2>/dev/null
  local rc=$?
  [ "$rc" -le 1 ] || return 2
  return "$rc"
}

# A url_regex entry is powerful: one sloppy pattern can deny everything, so
# validate hard and FAIL CLOSED if the protected list can't be consulted.
valid_url_regex() {
  local pat="$1" p list rc
  [ "${#pat}" -ge 4 ] || die "url pattern too short (min 4 chars): $pat"
  [ "${#pat}" -le 400 ] || die "url pattern too long"
  case "$pat" in
    '.*'|'^.*'|'^.*$'|'.'|'.+'|'^'|'$'|'//'|'http'|'https'|'http.*'|'https.*')
      die "pattern '$pat' is far too broad — it would deny everything" 5 ;;
  esac

  # must be a valid POSIX ERE (the flavour Squid's url_regex uses)
  re_match "canary-probe-string" "$pat"; rc=$?
  [ "$rc" -eq 2 ] && die "not a valid regular expression: $pat"

  # never allow a pattern that would also hit something we must never block
  list="$(load_protected 2>/dev/null)"
  [ -n "$list" ] || die "protected list unreadable — refusing (fail-closed)" 5
  while IFS= read -r p; do
    p="${p%%#*}"
    p="$(printf '%s' "$p" | tr -d '[:space:]' | tr 'A-Z' 'a-z')"
    [ -z "$p" ] && continue
    p="${p#.}"
    for scheme in http https; do
      if re_match "$scheme://$p/" "$pat"; then
        die "pattern would also block protected domain '$p'" 5
      fi
      if re_match "$scheme://www.$p/some/path" "$pat"; then
        die "pattern would also block protected domain '$p'" 5
      fi
    done
  done <<< "$list"

  # and not a pattern so loose it catches ordinary traffic
  for u in "${CANARY_URLS[@]}"; do
    if re_match "$u" "$pat"; then
      die "pattern is too broad — it matches ordinary traffic ($u)" 5
    fi
  done
  return 0
}

load_protected() {
  printf '%s\n' "${DEFAULT_PROTECTED[@]}"
  [ -f "$PROTECT" ] && grep -vE '^\s*(#|$)' "$PROTECT" || true
}

# is $1 protected, either exactly or as a subdomain of a protected entry?
# Fails CLOSED: if the protected list cannot be read, treat as protected.
is_protected() {
  local cand="${1#.}" p list
  cand="$(printf '%s' "$cand" | tr 'A-Z' 'a-z')"
  list="$(load_protected 2>/dev/null)"
  if [ -z "$list" ]; then
    echo "WARNING: protected list unreadable — refusing change (fail-closed)" >&2
    return 0
  fi
  # here-string instead of process substitution: portable, no /dev/fd needed
  while IFS= read -r p; do
    p="${p%%#*}"
    p="$(printf '%s' "$p" | tr -d '[:space:]' | tr 'A-Z' 'a-z')"
    [ -z "$p" ] && continue
    p="${p#.}"
    [ "$cand" = "$p" ] && return 0
    case "$cand" in *".$p") return 0 ;; esac
  done <<< "$list"
  return 1
}

# ---------------------------------------------------------------- operations
ensure_files() {
  mkdir -p "$DIR" "$BACKUPS" 2>/dev/null || true
  local k f ph
  for k in domains ips urls allow; do
    f="$(file_for "$k")"; ph="$(placeholder_for "$k")"
    if [ ! -f "$f" ]; then
      {
        echo "# Managed by squid-blocklist — one entry per line."
        echo "# The placeholder below keeps the ACL non-empty (Squid requires it)."
        echo "$ph"
      } > "$f"
      chmod 0644 "$f"
    fi
  done
  [ -f "$PROTECT" ] || {
    {
      echo "# Domains that squid-blocklist must NEVER block."
      echo "# One per line. Subdomains are covered automatically."
      printf '%s\n' "${DEFAULT_PROTECTED[@]}"
    } > "$PROTECT"
    chmod 0644 "$PROTECT"
  }
}

backup_of() {
  local f="$1"
  echo "$BACKUPS/$(basename "$f").$(date +%Y%m%d-%H%M%S).$$"
}

audit() {
  local msg="$1"
  local who="${SUDO_USER:-${USER:-unknown}}"
  local from="${SSH_CLIENT:-}"; from="${from%% *}"
  mkdir -p "$(dirname "$AUDIT")" 2>/dev/null || true
  printf '%s\tuser=%s\tfrom=%s\t%s\n' \
    "$(date -Iseconds)" "$who" "${from:-local}" "$msg" >> "$AUDIT" 2>/dev/null || true
}

squid_running() { pgrep -x squid >/dev/null 2>&1; }

# validate config, then reload; restore $2 (backup) on failure
apply_or_restore() {
  local target="$1" backup="$2" what="$3"
  local out
  if ! out="$("$SQUID_BIN" -k parse 2>&1)"; then
    cp -f "$backup" "$target"
    audit "REJECTED $what — squid refused config, rolled back"
    echo "$out" | tail -5 >&2
    die "Squid rejected the new config — change rolled back" 3
  fi
  if squid_running; then
    if ! out="$("$SQUID_BIN" -k reconfigure 2>&1)"; then
      cp -f "$backup" "$target"
      "$SQUID_BIN" -k reconfigure >/dev/null 2>&1 || true
      audit "RELOAD-FAILED $what — rolled back"
      echo "$out" | tail -5 >&2
      die "reload failed — change rolled back" 4
    fi
    info "squid reloaded"
  else
    info "note: squid is not running — config saved, will apply on start"
  fi
}

cmd_init() {
  ensure_files
  info "Created/verified:"
  info "  $DOMAINS"
  info "  $IPS"
  info "  $URLS      (url_regex — HTTP only, see note below)"
  info "  $ALLOW"
  info "  $PROTECT   (never-block list)"
  info "  $BACKUPS/  (automatic backups)"
  cat <<EOF

Add these lines to squid.conf ABOVE your 'http_access allow' rules:

    acl blocked_domains dstdomain "$DOMAINS"
    acl blocked_srcips  src       "$IPS"
    acl blocked_urls    url_regex "$URLS"
    acl allowed_domains dstdomain "$ALLOW"

    http_access allow allowed_domains
    http_access deny  blocked_domains
    http_access deny  blocked_srcips
    http_access deny  blocked_urls

  ---- how a blocked request should FAIL -------------------------------------
  Default (no extra line): Squid returns a 403 "Access Denied" page, so the
  user can tell the proxy blocked them.

  To DROP the connection instead (looks like the site is simply unreachable),
  add ONE deny_info line per acl, immediately AFTER the http_access rules:

    deny_info TCP_RESET blocked_domains
    deny_info TCP_RESET blocked_srcips
    deny_info TCP_RESET blocked_urls

  TCP_RESET sends a TCP reset — the browser shows a connection error, not a
  proxy block page. For HTTPS (CONNECT) this is the cleaner behaviour, since a
  403 on CONNECT surfaces as a confusing TLS failure anyway.

  ---- url_regex only sees plain HTTP ---------------------------------------
  For https:// traffic Squid sees only "host:443" (CONNECT), never the path.
  So blocked_urls can match http:// URLs only, unless SSL bump is configured.
  To block an HTTPS site, add its DOMAIN to $DOMAINS instead.

Then:  $SQUID_BIN -k parse && $SQUID_BIN -k reconfigure
EOF
  audit "INIT"
}

cmd_list() {
  local f; f="$(file_for "$1")"
  [ -f "$f" ] || { echo ""; return 0; }
  grep -vE '^\s*(#|$)' "$f" || true
}

cmd_status() {
  echo "dir=$DIR"
  echo "squid_running=$(squid_running && echo yes || echo no)"
  local k f
  for k in domains ips urls allow; do
    f="$(file_for "$k")"
    echo "$k=$([ -f "$f" ] && (grep -vcE '^\s*(#|$)' "$f" || echo 0) || echo missing)"
  done
  echo "backups=$(ls -1 "$BACKUPS" 2>/dev/null | wc -l | tr -d ' ')"
  echo "protected=$(load_protected | grep -vcE '^\s*(#|$)' || echo 0)"
}

cmd_add() {
  local kind="$1" entry="$2" f ph
  f="$(file_for "$kind")"; ph="$(placeholder_for "$kind")"
  if [ "$kind" = "urls" ]; then
    entry="$(printf '%s' "$entry" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  else
    entry="$(printf '%s' "$entry" | tr -d '[:space:]' | tr 'A-Z' 'a-z')"
  fi
  [ -n "$entry" ] || die "empty entry"

  case "$kind" in
    domains|allow) valid_domain "$entry" || die "not a valid domain: $entry" ;;
    ips)           valid_ip_or_cidr "$entry" || die "not a valid IP/CIDR: $entry" ;;
    urls)          valid_url_regex "$entry" ;;
  esac
  # protection applies to blocking, not to allowing
  if [ "$kind" = "domains" ] && is_protected "$entry"; then
    audit "REFUSED add domains $entry (protected)"
    die "'$entry' is on the protected never-block list" 5
  fi

  ensure_files
  exec 9>"$LOCK"; flock -w 10 9 || die "another change is in progress"

  if grep -qxF "$entry" "$f"; then
    info "already present: $entry"; exit 0
  fi
  local bak; bak="$(backup_of "$f")"
  cp -f "$f" "$bak"
  printf '%s\n' "$entry" >> "$f"
  apply_or_restore "$f" "$bak" "add $kind $entry"
  audit "ADD $kind $entry"
  info "added: $entry"
}

cmd_del() {
  local kind="$1" entry="$2" f ph
  f="$(file_for "$kind")"; ph="$(placeholder_for "$kind")"
  if [ "$kind" = "urls" ]; then
    entry="$(printf '%s' "$entry" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  else
    entry="$(printf '%s' "$entry" | tr -d '[:space:]' | tr 'A-Z' 'a-z')"
  fi
  [ -n "$entry" ] || die "empty entry"
  [ -f "$f" ] || die "no such list file: $f"
  if [ "$entry" = "$ph" ]; then
    die "refusing to remove the placeholder (keeps the ACL non-empty)" 5
  fi
  grep -qxF "$entry" "$f" || { info "not present: $entry"; exit 0; }

  exec 9>"$LOCK"; flock -w 10 9 || die "another change is in progress"
  local bak; bak="$(backup_of "$f")"
  cp -f "$f" "$bak"
  grep -vxF "$entry" "$bak" > "$f"
  # never let the list go empty
  if ! grep -qvE '^\s*(#|$)' "$f"; then printf '%s\n' "$ph" >> "$f"; fi
  apply_or_restore "$f" "$bak" "del $kind $entry"
  audit "DEL $kind $entry"
  info "removed: $entry"
}

cmd_rollback() {
  local kind="$1" f last
  f="$(file_for "$kind")"
  last="$(ls -1t "$BACKUPS/$(basename "$f")".* 2>/dev/null | head -1 || true)"
  [ -n "$last" ] || die "no backup to roll back to for $kind"
  exec 9>"$LOCK"; flock -w 10 9 || die "another change is in progress"
  local cur; cur="$(backup_of "$f")"
  cp -f "$f" "$cur"
  cp -f "$last" "$f"
  apply_or_restore "$f" "$cur" "rollback $kind"
  audit "ROLLBACK $kind <- $(basename "$last")"
  info "rolled back $kind to $(basename "$last")"
}

# ---------------------------------------------------------------------- main
self_check
cmd="${1:-}"; shift || true
case "$cmd" in
  init)     cmd_init ;;
  status)   cmd_status ;;
  list)     [ $# -ge 1 ] || die "usage: list <domains|ips|urls|allow>"
            require_kind "$1"; cmd_list "$1" ;;
  add)      [ $# -ge 2 ] || die "usage: add <domains|ips|urls|allow> <entry>"
            require_kind "$1"; cmd_add "$1" "$2" ;;
  del)      [ $# -ge 2 ] || die "usage: del <domains|ips|urls|allow> <entry>"
            require_kind "$1"; cmd_del "$1" "$2" ;;
  rollback) [ $# -ge 1 ] || die "usage: rollback <domains|ips|urls|allow>"
            require_kind "$1"; cmd_rollback "$1" ;;
  *) sed -n '2,30p' "$0" | sed 's/^#\s\?//'; exit 2 ;;
esac
