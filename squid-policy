# Automatic translations from PCRE-only syntax to the POSIX ERE that Squid's
# url_regex actually compiles. Only mechanical, meaning-preserving rewrites
# belong here; anything ambiguous is reported for a human to decide.
PCRE_REPAIRS = (
    (r"(?:", r"(", "non-capturing group (?:...) -> plain group (...)"),
    (r"\b", r"", "word-boundary \\b removed (PCRE-only)"),
    (r"\d", r"[0-9]", "\\d -> [0-9]"),
    (r"\w", r"[A-Za-z0-9_]", "\\w -> [A-Za-z0-9_]"),
    (r"\s", r"[[:space:]]", "\\s -> [[:space:]]"),
    (r"\A", r"^", "\\A -> ^"),
    (r"\Z", r"$", "\\Z -> $"),
)
UNREPAIRABLE = ((r"(?=", "lookahead"), (r"(?!", "negative lookahead"),
                (r"(?<", "lookbehind"), (r"(?P", "named group"))


def repair_pattern(pat):
    """Return (new_pattern, [notes]) — mechanically POSIX-ERE-safe."""
    notes = []
    for token, label in UNREPAIRABLE:
        if token in pat:
            return None, [f"{label} {token!r} has no POSIX ERE equivalent — "
                          f"rewrite this pattern by hand"]
    new = pat
    for token, repl, label in PCRE_REPAIRS:
        if token in new:
            new = new.replace(token, repl)
            notes.append(label)
    return new, notes


