def include_present():
    """Is the `include .../rules.conf` line actually in squid.conf?

    Both halves must be true for a policy to be enforced: rules.conf has to
    exist AND squid.conf has to include it. Miss the include and every push
    still reports success while Squid never reads a word of it. squid.conf is
    not world-readable and the sudoers grant covers only this helper, so an
    external `grep` cannot answer the question — the helper has to.
    """
    try:
        with open(SQUID_CONF) as fh:
            body = "\n".join(l.split("#", 1)[0] for l in fh)
    except OSError:
        return None                      # unknown, not "missing"
    return os.path.basename(RULES) in body


def cmd_ready(_args):
    """One machine-readable answer: is this proxy fully wired up?"""
    inc = include_present()
    rules = os.path.exists(RULES)
    ok = bool(inc) and rules
    print(json.dumps({
        "ok": ok,
        "include_line": ("present" if inc else
                         "unknown (cannot read %s)" % SQUID_CONF if inc is None
                         else "MISSING"),
        "rules_conf": "present" if rules else "MISSING",
        "squid_conf": SQUID_CONF,
        "rules_path": RULES,
        "note": ("ready" if ok else
                 "policy changes would be accepted but NOT enforced"),
    }))
    if not ok:
        sys.exit(2)


