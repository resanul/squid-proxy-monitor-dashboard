def squid_running():
    try:
        return subprocess.run(["pgrep", "-x", "squid"], capture_output=True,
                              timeout=10).returncode == 0
    except Exception:                                          # noqa: BLE001
        return False


SAFE_PLACEHOLDER = (
    "# squid-policy: no valid configuration has been applied yet.\n"
    "# This file is intentionally left empty (a harmless no-op) so that the\n"
    "# `include` line in squid.conf keeps resolving to a real file instead of\n"
    "# a missing one. Fix the reported error and run `squid-policy apply`\n"
    "# again.\n"
)


def _print_squid_diagnostics(output):
    """Surface the real error instead of Squid's fixed-length exit banner.

    Squid always ends a failed run with the same 4-line summary
    ("Terminated abnormally" / "CPU Usage" / "Maximum Resident Size" /
    "Page faults") — printing only the last 4 lines of output (the old
    behaviour here) therefore ALWAYS hides the actual `FATAL:`/`ERROR:` line,
    which appears earlier. This was found live: a dstdomain conflict and
    later a bad url_regex both had their real cause masked for several retry
    attempts because only that trailing banner was ever shown.
    """
    lines = (output or "").strip().splitlines()
    if not lines:
        return
    hits = [l for l in lines if ("FATAL" in l or "ERROR" in l
                                  or "error" in l.lower())]
    if hits:
        print("\n".join(hits), file=sys.stderr)
        banner = lines[-4:]
        if banner and banner != hits[-len(banner):]:
            print("--- squid exit summary ---", file=sys.stderr)
            print("\n".join(banner), file=sys.stderr)
    else:
        # No recognisable marker — better to over-share than hide the cause.
        print("\n".join(lines[-40:]), file=sys.stderr)


def snapshot_lists():
    """Copy the ACL value files aside so a failed apply can restore them.

    generate() rewrites lists/*.txt before apply_config() gets a chance to
    validate anything, and the file NAMES are stable. So restoring only
    rules.conf after a rejected apply leaves the previous rules.conf reading
    the NEW list contents — the proxy then enforces the rejected values while
    policy.json still describes the old ones. Found by a fleet test where a
    node reported a clean rollback but was quietly blocking the wrong domain.
    """
    if not os.path.isdir(LISTS):
        return None
    snap = {}
    for name in os.listdir(LISTS):
        p = os.path.join(LISTS, name)
        if os.path.isfile(p):
            try:
                with open(p, "rb") as fh:
                    snap[name] = fh.read()
            except OSError:
                pass
    return snap


def restore_lists(snap):
    """Put the ACL value files back exactly as snapshot_lists() found them."""
    if snap is None:
        return
    os.makedirs(LISTS, exist_ok=True)
    for name, body in snap.items():
        try:
            with open(os.path.join(LISTS, name), "wb") as fh:
                fh.write(body)
        except OSError:
            pass
    # remove files that did not exist before, so a rejected apply cannot leave
    # a brand-new list file behind for a later config to pick up
    try:
        for name in os.listdir(LISTS):
            if name not in snap:
                p = os.path.join(LISTS, name)
                if os.path.isfile(p):
                    os.remove(p)
    except OSError:
        pass


def generate_and_apply(norm, what):
    """generate() + apply_config(), with the ACL files restored on failure."""
    snap = snapshot_lists()
    try:
        text = generate(norm)
        apply_config(text, what)
    except Refuse:
        restore_lists(snap)
        if squid_running():
            # the values Squid has loaded must match the restored files
            subprocess.run([SQUID_BIN, "-k", "reconfigure"],
                           capture_output=True, timeout=60)
        raise
    return text


def apply_config(text, what="apply"):
    os.makedirs(BACKUPS, exist_ok=True)
    prev = None
    if os.path.exists(RULES):
        prev = os.path.join(BACKUPS, f"rules.conf.{time.strftime('%Y%m%d-%H%M%S')}")
        shutil.copy2(RULES, prev)
    # keep the last 30 generations so this directory can't grow forever
    try:
        old = sorted(os.listdir(BACKUPS), reverse=True)[30:]
        for f in old:
            os.remove(os.path.join(BACKUPS, f))
    except OSError:
        pass

    tmp = RULES + ".tmp"
    with open(tmp, "w") as fh:
        fh.write(text)
    os.chmod(tmp, 0o644)
    os.replace(tmp, RULES)

    def restore(reason, code):
        if prev:
            shutil.copy2(prev, RULES)
        else:
            # No prior good generation exists yet (this is the very first
            # apply). Deleting RULES here — the old behaviour — leaves
            # squid.conf's `include RULES` line pointing at a file that no
            # longer exists, which makes EVERY subsequent `squid -k parse`
            # fail with a generic "Unable to find configuration file" error,
            # no matter what gets fixed afterwards. That masked the real
            # dstdomain/regex errors for multiple retries during live
            # testing on 10.50.0.12. Write a harmless empty include
            # instead so the file always exists and future retries surface
            # their own real error.
            with open(RULES, "w") as fh:
                fh.write(SAFE_PLACEHOLDER)
            os.chmod(RULES, 0o644)
        if squid_running():
            subprocess.run([SQUID_BIN, "-k", "reconfigure"],
                           capture_output=True, timeout=60)
        audit(f"ROLLBACK {what} — {reason}")
        raise Refuse(f"{reason} — configuration rolled back", code)

    r = subprocess.run([SQUID_BIN, "-k", "parse"], capture_output=True,
                       text=True, timeout=60)
    if r.returncode != 0:
        _print_squid_diagnostics(r.stderr or r.stdout)
        restore("squid rejected the generated config", 3)

    if squid_running():
        r = subprocess.run([SQUID_BIN, "-k", "reconfigure"], capture_output=True,
                           text=True, timeout=60)
        if r.returncode != 0:
            _print_squid_diagnostics(r.stderr or r.stdout)
            restore("squid reload failed", 4)
        print("squid reloaded")
    else:
        print("note: squid is not running — config written, applies on start")


def load_policy():
    if not os.path.exists(POLICY):
        raise Refuse(f"no policy file at {POLICY} — run `squid-policy init`")
    with open(POLICY) as fh:
        return json.load(fh)


def save_policy(policy):
    os.makedirs(DIR, exist_ok=True)
    tmp = POLICY + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(policy, fh, indent=2)
    os.chmod(tmp, 0o600)          # may name internal hosts/IPs
    os.replace(tmp, POLICY)


