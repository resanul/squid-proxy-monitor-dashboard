def conf_guards(text, force=False):
    """Refuse edits that break the proxy in ways Squid itself will not catch.

    `squid -k parse` accepts plenty of configs that are operationally wrong.
    These two in particular are silent and severe:

      * dropping the `include .../rules.conf` line — Squid starts happily and
        every per-IP rule simply stops existing, so the UI keeps showing a
        policy that is no longer enforced
      * dropping the final `http_access deny all` — the proxy becomes
        fail-open, allowing whatever the earlier rules did not explicitly
        cover

    Both are overridable, because there are legitimate reasons to restructure
    a config, but never by accident and always recorded in the audit log.
    """
    problems = []
    body = "\n".join(l.split("#", 1)[0] for l in text.splitlines())
    if os.path.basename(RULES) not in body:
        problems.append(
            f"the `include {RULES}` line is gone — Squid would still start, but "
            f"every per-IP policy rule would stop being enforced")
    if not re.search(r"^\s*http_access\s+deny\s+all\s*$", body, re.M):
        problems.append(
            "there is no `http_access deny all` left — the proxy would "
            "fail open, allowing anything the earlier rules do not cover")
    if not re.search(r"^\s*http_port\s+\d+", body, re.M):
        problems.append("no `http_port` line — Squid would not listen at all")
    if force:
        return [f"OVERRIDDEN: {p}" for p in problems]
    if problems:
        raise Refuse("refusing to save: " + " | ".join(problems)
                     + "  (pass --force to override deliberately)", 5)
    return []


def apply_squid_conf(text, force=False):
    """Validate, back up, install and reload — rolling back on any failure."""
    if not text.strip():
        raise Refuse("refusing to write an empty squid.conf", 5)
    if len(text) > CONF_MAX:
        raise Refuse(f"squid.conf larger than {CONF_MAX // 1024} KB — refusing", 5)
    overrides = conf_guards(text, force)

    os.makedirs(CONF_BACKUPS, exist_ok=True)
    stamp = time.strftime("%Y%m%d-%H%M%S")
    backup = os.path.join(CONF_BACKUPS, f"squid.conf.{stamp}")
    prev = None
    if os.path.exists(SQUID_CONF):
        shutil.copy2(SQUID_CONF, backup)
        prev = backup
    try:                                     # keep the last 40 generations
        old = sorted(os.listdir(CONF_BACKUPS), reverse=True)[40:]
        for f in old:
            os.remove(os.path.join(CONF_BACKUPS, f))
    except OSError:
        pass

    st = os.stat(SQUID_CONF) if os.path.exists(SQUID_CONF) else None
    tmp = SQUID_CONF + ".sqpol.tmp"
    with open(tmp, "w") as fh:
        fh.write(text if text.endswith("\n") else text + "\n")
    if st:
        os.chmod(tmp, st.st_mode & 0o7777)
        try:
            os.chown(tmp, st.st_uid, st.st_gid)
        except OSError:
            pass
    os.replace(tmp, SQUID_CONF)

    def rollback(reason, code):
        if prev:
            shutil.copy2(prev, SQUID_CONF)
            if squid_running():
                subprocess.run([SQUID_BIN, "-k", "reconfigure"],
                               capture_output=True, timeout=60)
        audit(f"CONF ROLLBACK — {reason}")
        raise Refuse(f"{reason} — squid.conf restored from {prev or '(no backup)'}",
                     code)

    r = subprocess.run([SQUID_BIN, "-k", "parse"], capture_output=True,
                       text=True, timeout=60)
    if r.returncode != 0:
        _print_squid_diagnostics(r.stderr or r.stdout)
        rollback("squid rejected the new squid.conf", 3)

    if squid_running():
        r = subprocess.run([SQUID_BIN, "-k", "reconfigure"], capture_output=True,
                           text=True, timeout=60)
        if r.returncode != 0:
            _print_squid_diagnostics(r.stderr or r.stdout)
            rollback("reload failed with the new squid.conf", 4)
        reloaded = True
    else:
        reloaded = False
    audit(f"CONF SAVE ok backup={os.path.basename(backup)}"
          + ("".join(" " + o for o in overrides) if overrides else ""))
    return {"ok": True, "backup": os.path.basename(backup),
            "reloaded": reloaded, "overrides": overrides,
            "bytes": len(text)}


def cmd_conf_get(_args):
    if not os.path.exists(SQUID_CONF):
        raise Refuse(f"{SQUID_CONF} does not exist", 2)
    with open(SQUID_CONF) as fh:
        text = fh.read()
    print(json.dumps({"ok": True, "path": SQUID_CONF, "text": text,
                      "bytes": len(text),
                      "mtime": os.path.getmtime(SQUID_CONF)}))


def cmd_conf_check(args):
    """Validate a candidate squid.conf from stdin WITHOUT installing it."""
    text = sys.stdin.read()
    if not text.strip():
        raise Refuse("expected the new squid.conf on stdin", 2)
    warnings = conf_guards(text, force=True)
    blocking = [w[len("OVERRIDDEN: "):] for w in warnings]
    # parse it for real, in a temporary location, without touching the live file
    tmpdir = os.path.join(DIR, ".confcheck")
    os.makedirs(tmpdir, exist_ok=True)
    probe = os.path.join(tmpdir, "squid.conf")
    with open(probe, "w") as fh:
        fh.write(text)
    r = subprocess.run([SQUID_BIN, "-k", "parse", "-f", probe],
                       capture_output=True, text=True, timeout=60)
    out = (r.stderr or r.stdout or "")
    bad = [l for l in out.splitlines() if "FATAL" in l or "ERROR" in l]
    try:
        os.remove(probe)
    except OSError:
        pass
    print(json.dumps({"ok": r.returncode == 0 and not blocking,
                      "parses": r.returncode == 0,
                      "guards": blocking,
                      "squid_errors": bad[:20],
                      "would_force": bool(blocking)}))
    if r.returncode != 0 or blocking:
        sys.exit(2)


def cmd_conf_save(args):
    text = sys.stdin.read()
    print(json.dumps(apply_squid_conf(text, force=getattr(args, "force", False))))


def cmd_conf_backups(_args):
    if not os.path.isdir(CONF_BACKUPS):
        print(json.dumps({"ok": True, "backups": []}))
        return
    out = []
    for f in sorted(os.listdir(CONF_BACKUPS), reverse=True):
        p = os.path.join(CONF_BACKUPS, f)
        try:
            out.append({"name": f, "bytes": os.path.getsize(p),
                        "mtime": os.path.getmtime(p)})
        except OSError:
            pass
    print(json.dumps({"ok": True, "backups": out}))


def cmd_conf_restore(args):
    name = (args.name or "").strip()
    if not name or "/" in name or name.startswith("."):
        raise Refuse("usage: conf-restore <backup-name> (see conf-backups)", 2)
    p = os.path.join(CONF_BACKUPS, name)
    if not os.path.exists(p):
        raise Refuse(f"no such backup: {name}", 2)
    with open(p) as fh:
        text = fh.read()
    # a restore of a previously-good file may legitimately predate the current
    # guards, so allow it through them but still gate on `squid -k parse`
    print(json.dumps(apply_squid_conf(text, force=True)))


def cmd_repair(args):
    """Fix PCRE-only url patterns in the STORED policy.

    A policy saved by an older build can contain patterns that the current,
    stricter validator rejects — which blocks `apply`, `show` and every other
    command that validates first, with no way forward from the CLI. This
    rewrites those patterns in place (after a backup) so the stored policy
    becomes applicable again, and reports exactly what it changed.
    """
    raw = load_policy()
    changed, manual = [], []
    for tier in ("security_block", "policy_block", "global_allow"):
        urls = (raw.get(tier) or {}).get("urls")
        if not isinstance(urls, list):
            continue
        for i, u in enumerate(list(urls)):
            new, notes = repair_pattern(str(u))
            if new is None:
                manual.append((tier, u, notes[0]))
            elif new != u:
                urls[i] = new
                changed.append((tier, u, new, "; ".join(notes)))
    for g in raw.get("groups", []):
        for key in ("deny_urls", "allow_urls"):
            urls = g.get(key)
            if not isinstance(urls, list):
                continue
            for i, u in enumerate(list(urls)):
                new, notes = repair_pattern(str(u))
                if new is None:
                    manual.append((f"{g.get('id')}.{key}", u, notes[0]))
                elif new != u:
                    urls[i] = new
                    changed.append((f"{g.get('id')}.{key}", u, new,
                                    "; ".join(notes)))

    if not changed and not manual:
        print("stored policy contains no PCRE-only url patterns — nothing "
              "to repair")
        return
    for where, old, new, why in changed:
        print(f"  [{where}]")
        print(f"      was : {old}")
        print(f"      now : {new}")
        print(f"      why : {why}")
    for where, pat, why in manual:
        print(f"  [{where}] NEEDS MANUAL FIX")
        print(f"      pattern: {pat}")
        print(f"      reason : {why}")
    if manual:
        raise Refuse(f"{len(manual)} pattern(s) cannot be repaired "
                     f"automatically — nothing was saved", 2)

    if getattr(args, "dry_run", False):
        print(f"\ndry run — {len(changed)} change(s) shown above, nothing "
              f"saved. Re-run without --dry-run to apply.")
        return

    # Confirm the repaired policy actually passes validation before saving,
    # so a repair can never leave the stored policy in a worse state.
    validate(raw)
    if os.path.exists(POLICY):
        os.makedirs(BACKUPS, exist_ok=True)
        bak = os.path.join(BACKUPS,
                           f"policy.json.{time.strftime('%Y%m%d-%H%M%S')}")
        shutil.copy2(POLICY, bak)
        print(f"\nbackup: {bak}")
    save_policy(raw)
    audit(f"REPAIR {len(changed)} url pattern(s)")
    print(f"repaired {len(changed)} pattern(s) and saved. The stored policy "
          f"now validates.\nRun `{sys.argv[0]} apply` to push it to Squid.")


def main():
    ap = argparse.ArgumentParser(
        description="Per-IP access policy compiler for Squid.")
    # Passed as ARGUMENTS, not environment variables. sudo refuses
    # `sudo VAR=x /usr/local/sbin/squid-policy` unless the sudoers rule carries
    # SETENV: — and adding SETENV: to a rule that runs a Python script would let
    # the caller set PYTHONPATH and execute their own code as root. Arguments
    # avoid that entirely.
    ap.add_argument("--acting-user", metavar="NAME",
                    help="record this operator in the audit log (the dashboard "
                         "passes the signed-in user; advisory only, the sudoers "
                         "grant still decides what may run)")
    ap.add_argument("--acting-from", metavar="ADDR",
                    help="record this source address in the audit log")
    sub = ap.add_subparsers(dest="cmd")
    ps = sub.add_parser("set", help="read a policy JSON on stdin, validate, apply")
    ps.add_argument("--dry-run", action="store_true",
                    help="validate and render only — change nothing")
    ps.set_defaults(func=cmd_set)

    for name, fn, helptext in (
            ("init", cmd_init, "create dirs + starter policy, print the include line"),
            ("get", cmd_get, "print the current policy JSON"),
            ("apply", cmd_apply, "regenerate and reload from the stored policy"),
            ("show", cmd_show, "human-readable summary"),
            ("ready", cmd_ready,
             "JSON: is the include line AND rules.conf in place? exit 2 if not"),
            ("rollback", cmd_rollback, "restore the previous generated config"),
            ("baseline", cmd_baseline, "print the industry-baseline policy"),
    ):
        p = sub.add_parser(name, help=helptext)
        p.set_defaults(func=fn)
    pr = sub.add_parser("repair",
                        help="rewrite PCRE-only url patterns in the stored "
                             "policy to POSIX ERE")
    pr.add_argument("--dry-run", action="store_true",
                    help="show what would change without saving")
    pr.set_defaults(func=cmd_repair)

    for name, fn, helptext in (
            ("conf-get", cmd_conf_get, "print the live squid.conf as JSON"),
            ("conf-check", cmd_conf_check,
             "validate a candidate squid.conf from stdin, change nothing"),
            ("conf-backups", cmd_conf_backups, "list squid.conf backups"),
    ):
        p = sub.add_parser(name, help=helptext)
        p.set_defaults(func=fn)
    pcs = sub.add_parser("conf-save",
                         help="install a new squid.conf from stdin (validate, "
                              "back up, reload, roll back on failure)")
    pcs.add_argument("--force", action="store_true",
                     help="override the safety guards (missing policy include "
                          "or missing `http_access deny all`)")
    pcs.set_defaults(func=cmd_conf_save)
    pcr = sub.add_parser("conf-restore", help="restore a squid.conf backup")
    pcr.add_argument("name", help="backup file name from conf-backups")
    pcr.set_defaults(func=cmd_conf_restore)

    pv = sub.add_parser("validate", help="dry run — validate without applying")
    pv.add_argument("--show-config", action="store_true",
                    help="also print the config that would be generated")
    pv.set_defaults(func=cmd_validate)

    args = ap.parse_args()
    ACTING["user"] = getattr(args, "acting_user", None)
    ACTING["from"] = getattr(args, "acting_from", None)
    if not getattr(args, "func", None):
        ap.print_help()
        return 2
    try:
        self_check()
        args.func(args)
    except Refuse as e:
        print(f"ERROR: {e}", file=sys.stderr)
        return e.code
    except (OSError, ValueError) as e:
        print(f"ERROR: {e}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
