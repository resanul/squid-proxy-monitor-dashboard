def cmd_get(_args):
    print(json.dumps(load_policy(), indent=2))


def cmd_set(args):
    raw = sys.stdin.read()
    if not raw.strip():
        raise Refuse("no JSON on stdin")
    try:
        incoming = json.loads(raw)
    except ValueError as e:
        raise Refuse(f"invalid JSON: {e}")
    norm = validate(incoming)
    if getattr(args, "dry_run", False):
        # generate() writes lists/*.txt as a side effect, so a "dry run" that
        # simply called it left NEW ACL values staged on the proxy under the
        # existing file names — harmless until the next reload for any reason,
        # at which point Squid would start enforcing a policy nobody applied.
        # Render it, then put the files back exactly as they were.
        snap = snapshot_lists()
        try:
            text = generate(norm)
        finally:
            restore_lists(snap)
        print(json.dumps({
            "ok": True, "dry_run": True,
            "groups": [{"id": g["id"], "name": g["name"], "mode": g["mode"],
                        "ips": len(g["ips"])} for g in norm["groups"]],
            "skipped": norm.get("_skipped", []),
            "rules": [l for l in text.splitlines()
                      if l.startswith("http_access") or l.startswith("deny_info")],
            "config": text,
        }, indent=2))
        return
    generate_and_apply(norm, "set")
    incoming["_normalised_at"] = time.strftime("%Y-%m-%dT%H:%M:%S")
    save_policy(incoming)
    n = len(norm["groups"])
    audit(f"SET {n} group(s), "
          f"{sum(len(g['ips']) for g in norm['groups'])} ip(s)")
    print(json.dumps({"ok": True, "applied": n,
                      "ips": sum(len(g["ips"]) for g in norm["groups"]),
                      "skipped": norm.get("_skipped", [])}))


